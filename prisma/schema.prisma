// Tangoline Inc. — Prisma schema (MongoDB Atlas)
// Numeric IDs are preserved from the legacy MySQL data via @map("_id"), so the
// application keeps using integer IDs. Values are assigned explicitly by nextId().

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

enum StockStatus {
  in_stock
  out_of_stock
}

enum OrderStatus {
  Pending
  Processing
  Completed
  Cancelled
}

enum AccountType {
  user
  admin
}

enum LoginStatus {
  success
  failed
}

/// Assigns the next integer ID for each collection (replaces MySQL autoincrement).
model Sequence {
  name  String @id @map("_id")
  value Int

  @@map("sequences")
}

model Admin {
  id        Int      @id @map("_id")
  username  String   @unique
  email     String   @unique
  password  String
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model User {
  id        Int        @id @map("_id")
  username  String     @unique
  email     String     @unique
  password  String
  fullName  String     @default("") @map("full_name")
  phone     String     @default("")
  address   String?
  city      String     @default("")
  status    UserStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  orders    Order[]
  cartItems CartItem[]
  downloads Download[]
  loginLogs LoginLog[]

  @@index([status], name: "idx_user_status")
  @@map("users")
}

model Category {
  id          Int      @id @map("_id")
  name        String   @unique
  slug        String   @unique
  description String?
  image       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id                 Int         @id @map("_id")
  categoryId         Int         @map("category_id")
  name               String
  slug               String      @unique
  brand              String      @default("Gaming")
  platform           String      @default("PlayStation 5")
  price              Float       @default(0)
  originalPrice      Float?      @map("original_price")
  shortDescription   String      @default("") @map("short_description")
  description        String
  specifications     String?
  systemRequirements String?     @map("system_requirements")
  image              String      @default("")
  docxFile           String      @default("") @map("docx_file")
  stockStatus        StockStatus @default(in_stock) @map("stock_status")
  isFeatured         Boolean     @default(false) @map("is_featured")
  viewsCount         Int         @default(0) @map("views_count")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  category   Category    @relation(fields: [categoryId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  orderItems OrderItem[]
  cartItems  CartItem[]
  downloads  Download[]

  @@index([categoryId], name: "idx_prod_category")
  @@index([brand], name: "idx_prod_brand")
  @@index([isFeatured], name: "idx_prod_featured")
  @@map("products")
}

model Order {
  id              Int         @id @map("_id")
  orderNumber     String      @unique @map("order_number")
  userId          Int?        @map("user_id")
  customerName    String      @map("customer_name")
  customerEmail   String      @map("customer_email")
  customerPhone   String      @map("customer_phone")
  shippingAddress String      @map("shipping_address")
  city            String
  postalCode      String      @default("") @map("postal_code")
  paymentMethod   String      @default("cash_on_delivery") @map("payment_method")
  subtotal        Float       @default(0)
  shippingFee     Float       @default(0) @map("shipping_fee")
  totalAmount     Float       @default(0) @map("total_amount")
  status          OrderStatus @default(Pending)
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([userId], name: "idx_order_user")
  @@index([status], name: "idx_order_status")
  @@map("orders")
}

model OrderItem {
  id           Int    @id @map("_id")
  orderId      Int    @map("order_id")
  productId    Int?   @map("product_id")
  productName  String @map("product_name")
  productPrice Float  @default(0) @map("product_price")
  quantity     Int    @default(1)
  subtotal     Float  @default(0)
  productImage String @default("") @map("product_image")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId], name: "idx_item_order")
  @@index([productId], name: "idx_item_product")
  @@map("order_items")
}

model CartItem {
  id        Int      @id @map("_id")
  userId    Int?     @map("user_id")
  sessionId String   @map("session_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId], name: "unique_cart_item")
  @@index([sessionId], name: "idx_cart_session")
  @@index([userId], name: "idx_cart_user")
  @@map("cart_items")
}

model Download {
  id           Int      @id @map("_id")
  productId    Int      @map("product_id")
  userId       Int?     @map("user_id")
  sessionId    String   @default("") @map("session_id")
  ipAddress    String   @default("") @map("ip_address")
  fileName     String   @map("file_name")
  downloadedAt DateTime @default(now()) @map("downloaded_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId], name: "idx_download_product")
  @@index([userId], name: "idx_download_user")
  @@index([downloadedAt], name: "idx_download_date")
  @@map("downloads")
}

model WebsiteVisit {
  id         Int      @id @map("_id")
  sessionId  String   @map("session_id")
  ipHash     String   @default("") @map("ip_hash")
  pageUrl    String   @map("page_url")
  userAgent  String   @default("") @map("user_agent")
  visitDate  DateTime @map("visit_date")
  visitedAt  DateTime @default(now()) @map("visited_at")

  @@index([visitDate], name: "idx_visit_date")
  @@index([sessionId, visitDate], name: "idx_visit_session_date")
  @@map("website_visits")
}

model LoginLog {
  id          Int         @id @map("_id")
  userId      Int?        @map("user_id")
  accountType AccountType @default(user) @map("account_type")
  identifier  String
  ipAddress   String      @default("") @map("ip_address")
  status      LoginStatus @default(success)
  userAgent   String      @default("") @map("user_agent")
  loginTime   DateTime    @default(now()) @map("login_time")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_login_user")
  @@index([accountType], name: "idx_login_type")
  @@index([loginTime], name: "idx_login_time")
  @@map("login_logs")
}

model ContactMessage {
  id        Int      @id @map("_id")
  name      String
  email     String
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead], name: "idx_contact_is_read")
  @@map("contact_messages")
}
