# ---------------------------------------------------------------------------
# Tangoline Inc. — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (SRV format for Atlas clusters).
# Create a database user, allow your IP in Network Access, then copy the URL.
# Include the database name in the path, e.g.:
# mongodb+srv://user:password@cluster0.abcde.mongodb.net/tangoline_db
DATABASE_URL="mongodb+srv://user:password@cluster0.abcde.mongodb.net/tangoline_db"

# Public base URL of the application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Secret used to sign session cookies (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional: where generated .docx specification files are stored.
# Defaults to <project root>/storage/fc
DOCX_STORAGE_DIR="storage/fc"
